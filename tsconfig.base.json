{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "useDefineForClassFields": false,
    "lib": ["ES2022", "dom"],
    "paths": {
      "@movies/shared/models": ["./libs/shared/models/src/index.ts"],
      "@movies/shared/util-env": ["./libs/shared/util-env/src/index.ts"],
      "@movies/shared/utils": ["./libs/shared/utils/src/index.ts"],
      "@movies/shared/ui-design-system": [
        "./libs/shared/ui-design-system/src/index.ts"
      ],
      "@movies/shared/data-access-auth": [
        "./libs/shared/data-access-auth/src/index.ts"
      ],
      "@movies/shared/feature-not-found": [
        "./libs/shared/feature-not-found/src/index.ts"
      ],
      "@movies/movies/data-access": ["./libs/movies/data-access/src/index.ts"],
      "@movies/movies/util-movie-image": [
        "./libs/movies/util-movie-image/src/index.ts"
      ],
      "@movies/movies/ui-movie-list": [
        "./libs/movies/ui-movie-list/src/index.ts"
      ],
      "@movies/movies/feature-app-shell": [
        "./libs/movies/feature-app-shell/src/index.ts"
      ],
      "@movies/movies/feature-movie-list": [
        "./libs/movies/feature-movie-list/src/index.ts"
      ],
      "@movies/movies/feature-movie-detail": [
        "./libs/movies/feature-movie-detail/src/index.ts"
      ],
      "@movies/movies/feature-movie-search": [
        "./libs/movies/feature-movie-search/src/index.ts"
      ],
      "@movies/movies/feature-my-movies": [
        "./libs/movies/feature-my-movies/src/index.ts"
      ],
      "@movies/movies/feature-my-movies-v2": [
        "./libs/movies/feature-my-movies-v2/src/index.ts"
      ]
    },
    "rootDir": "."
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "exclude": ["node_modules", "tmp"]
}
