{
  "name": "ws-ng-modern-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "serve:ssr:ws-ng-perf": "node dist/ws-ng-modern-angular/server/server.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-preset-angular",
    "setupFilesAfterEnv": [
      "<rootDir>/setup-jest.ts"
    ]
  },
  "dependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-browser-dynamic": "^22.0.1",
    "@angular/platform-server": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@angular/ssr": "22.0.1",
    "@push-based/ngx-fast-svg": "^18.1.0",
    "@rx-angular/cdk": "^21.0.0",
    "@rx-angular/state": "^21.0.0",
    "@rx-angular/template": "^21.0.0",
    "express": "^5.1.0",
    "ngxtension": "^6.0.0",
    "rxjs": "~7.8.0",
    "server-timing": "^3.3.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.0.0",
    "@angular-eslint/eslint-plugin": "22.0.0",
    "@angular-eslint/eslint-plugin-template": "22.0.0",
    "@angular-eslint/schematics": "22.0.0",
    "@angular-eslint/template-parser": "22.0.0",
    "@angular/build": "22.0.1",
    "@angular/cli": "22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "prettier": "^3.3.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@rx-angular/cdk": {
      "@angular/core": "$@angular/core"
    },
    "@rx-angular/state": {
      "@angular/core": "$@angular/core"
    },
    "@rx-angular/template": {
      "@angular/core": "$@angular/core"
    }
  }
}
